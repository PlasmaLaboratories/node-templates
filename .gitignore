# Downloaded database snapshots (multi-GB; produced by scripts/download-snapshot.sh).
# Tarballs live under config/<network>/snapshots/; keep only the README placeholder.
config/*/snapshots/*
!config/*/snapshots/README.md

# Root network selector symlink (.env -> config/<network>/.env), managed by scripts/use.sh.
# Untracked so each clone can pick its own network without git pull resetting it.
/.env

config/*/.env.secret
