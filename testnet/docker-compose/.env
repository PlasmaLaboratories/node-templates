OPEN_SSL_IMAGE=docker.io/alpine/openssl
OPEN_SSL_TAG=3.5.2@sha256:655d3849b676fdc7b19375c11ea62e4ae70a83179fb77206803c0199e3be2b15

PLASMA_CONSENSUS_IMAGE=ghcr.io/plasmalaboratories/plasma-consensus-public
PLASMA_CONSENSUS_TAG=0.15.0

PLASMA_EXECUTION_IMAGE=ghcr.io/paradigmxyz/reth
PLASMA_EXECUTION_TAG=v1.8.3

NETWORK="testnet"

# Host directory containing the downloaded snapshot tarballs
# (consensus-backup-*.tar.gz and execution-backup-*.tar.gz). Used by docker-compose.yml.
# Relative paths resolve against this directory (testnet/docker-compose); the
# default points at the repo-root backups/testnet that download-snapshot.sh writes to.
SNAPSHOT_DIR="../../backups/testnet"
